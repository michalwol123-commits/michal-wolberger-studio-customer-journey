    {
      "function_name": "setProjectStage",
      "description": "\u05d4\u05d3\u05e8\u05da \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05dc\u05d4\u05e2\u05d1\u05d9\u05e8 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05dc\u05e9\u05dc\u05d1: \u05e7\u05d3\u05d9\u05de\u05d4, \u05d1\u05d3\u05d9\u05dc\u05d5\u05d2 \u05d0\u05d5 \u05d0\u05d7\u05d5\u05e8\u05d4. \u05e4\u05e8\u05de\u05d8\u05e8\u05d9\u05dd: project_id, target_stage (1-13), mode (advance = \u05dc\u05e9\u05dc\u05d1 \u05d4\u05d1\u05d0, \u05e2\u05dd \u05d1\u05d3\u05d9\u05e7\u05ea \u05e4\u05e8\u05d9\u05d8\u05d9 \u05d4\u05d7\u05d5\u05d1\u05d4 \u05d1\u05e6'\u05e7\u05dc\u05d9\u05e1\u05d8; jump = \u05d3\u05d9\u05dc\u05d5\u05d2 \u05d0\u05d5 \u05d7\u05d6\u05e8\u05d4), leave_current_as (completed / skipped / pending), notify_client (true/false), dry_run (\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc true: \u05e8\u05e7 \u05de\u05e1\u05d1\u05d9\u05e8 \u05de\u05d4 \u05d9\u05e7\u05e8\u05d4). \u05e9\u05dc\u05d1\u05d9\u05dd \u05e9\u05de\u05d3\u05dc\u05d2\u05d9\u05dd \u05e2\u05dc\u05d9\u05d4\u05dd \u05de\u05e1\u05d5\u05de\u05e0\u05d9\u05dd '\u05d3\u05d5\u05dc\u05d2'."
    },
    {
      "function_name": "agentSendMessage",
      "description": "\u05e9\u05d5\u05dc\u05d7 \u05d4\u05d5\u05d3\u05e2\u05d4 \u05dc\u05dc\u05e7\u05d5\u05d7. \u05d1\u05de\u05e6\u05d1 \u05d3\u05d5\u05d2\u05de\u05d4 \u05e0\u05e9\u05dc\u05d7 \u05dc\u05de\u05d9\u05db\u05dc \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4. \u05e4\u05e8\u05de\u05d8\u05e8\u05d9\u05dd: client_id, content, subject"
    },
    {
      "function_name": "agentMeeting",
      "description": "\u05db\u05dc \u05e4\u05e2\u05d5\u05dc\u05d4 \u05e2\u05dc \u05e4\u05d2\u05d9\u05e9\u05d5\u05ea, \u05d1\u05e9\u05e2\u05d5\u05df \u05d9\u05e9\u05e8\u05d0\u05dc. action: now / list / create / reschedule / cancel / complete / no_show / log_past / update. \u05e4\u05e8\u05de\u05d8\u05e8\u05d9\u05dd \u05dc\u05e4\u05d9 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4: client_id, project_id, meeting_id, type, custom_title, date (YYYY-MM-DD), time (HH:mm \u05d1\u05e9\u05e2\u05d5\u05df \u05d9\u05e9\u05e8\u05d0\u05dc, \u05d1\u05d3\u05d9\u05d5\u05e7 \u05db\u05e4\u05d9 \u05e9\u05de\u05d9\u05db\u05dc \u05d0\u05de\u05e8\u05d4), duration, location, summary, stage_ref, meeting_price, from_date, to_date, dry_run (\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc true: \u05ea\u05e6\u05d5\u05d2\u05d4 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 \u05d1\u05dc\u05d9 \u05dc\u05e9\u05e0\u05d5\u05ea \u05db\u05dc\u05d5\u05dd). \u05de\u05d7\u05d6\u05d9\u05e8 when_israel \u05de\u05d5\u05db\u05df \u05dc\u05d4\u05e6\u05d2\u05d4."
    },
    {
      "function_name": "meetingSummary",
      "description": "\u05e1\u05d9\u05db\u05d5\u05dd \u05e4\u05d2\u05d9\u05e9\u05d4. action=save: meeting_id, internal_notes, append (true \u05db\u05d3\u05d9 \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05dc\u05e1\u05d9\u05db\u05d5\u05dd \u05e7\u05d9\u05d9\u05dd), notes_files (\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9 \u05ea\u05de\u05d5\u05e0\u05d5\u05ea). action=transcribe: file_url \u05d0\u05d5 file_urls \u05e9\u05dc \u05db\u05ea\u05d1 \u05d9\u05d3 \u05d0\u05d5 \u05d3\u05e3 \u05de\u05e6\u05d5\u05dc\u05dd, \u05d5\u05de\u05d7\u05d6\u05d9\u05e8 text. action=share: meeting_id, client_summary (\u05d4\u05e0\u05d5\u05e1\u05d7 \u05dc\u05dc\u05e7\u05d5\u05d7), send_message (\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc true), dry_run (\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc true). share \u05de\u05d5\u05e1\u05d9\u05e3 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05dd \u05dc\u05e4\u05d5\u05e8\u05d8\u05dc \u05d5\u05e9\u05d5\u05dc\u05d7 \u05dc\u05dc\u05e7\u05d5\u05d7 \u05d3\u05e8\u05da agentSendMessage."
    },
    {
      "function_name": "extractDesignFromText",
      "description": "\u05de\u05e4\u05e8\u05e7 \u05d8\u05e7\u05e1\u05d8 (\u05dc\u05de\u05e9\u05dc \u05e1\u05d9\u05db\u05d5\u05dd \u05e4\u05d2\u05d9\u05e9\u05d4) \u05dc\u05e4\u05e8\u05d9\u05d8\u05d9 \u05e2\u05d9\u05e6\u05d5\u05d1 \u05dc\u05e4\u05d9 \u05d7\u05d3\u05e8 \u05d5\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4. \u05e4\u05e8\u05de\u05d8\u05e8\u05d9\u05dd: text. \u05de\u05d7\u05d6\u05d9\u05e8 items \u05d5-summary \u05d5\u05dc\u05d0 \u05e9\u05d5\u05de\u05e8 \u05db\u05dc\u05d5\u05dd. \u05dc\u05e9\u05de\u05d9\u05e8\u05d4: \u05dc\u05d9\u05e6\u05d5\u05e8 DesignItem \u05dc\u05db\u05dc \u05e4\u05e8\u05d9\u05d8 \u05e9\u05de\u05d9\u05db\u05dc \u05d0\u05d9\u05e9\u05e8\u05d4."
    },
    {
      "function_name": "agentGenerateRender",
      "description": "\u05d9\u05d5\u05e6\u05e8 \u05e8\u05e0\u05d3\u05e8 AI \u05d5\u05e9\u05d5\u05de\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05d1\u05dc\u05d5\u05d7 \u05d4\u05d4\u05e9\u05e8\u05d0\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 (\u05dc\u05d0 \u05d2\u05dc\u05d5\u05d9 \u05dc\u05dc\u05e7\u05d5\u05d7). \u05e4\u05e8\u05de\u05d8\u05e8\u05d9\u05dd: project_id, prompt (\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8), room, title. \u05de\u05d7\u05d6\u05d9\u05e8 image_url \u05d5\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05dc\u05d5\u05d7."
    },
    {
      "entity_name": "AgentSettings",
      "allowed_operations": [
        "read",
        "update"
      ]
    },
    {
      "function_name": "generateQuotePDF",
      "description": "\u05de\u05e4\u05d9\u05e7 PDF \u05dc\u05d4\u05e6\u05e2\u05ea \u05de\u05d7\u05d9\u05e8/\u05d4\u05e1\u05db\u05dd. \u05e4\u05e8\u05de\u05d8\u05e8\u05d9\u05dd: client_id, quote_id, total_amount (\u05d7\u05d5\u05d1\u05d4, \u05de\u05ea\u05d5\u05da \u05d4\u05d4\u05e6\u05e2\u05d4), meeting_date, part (quote=\u05d4\u05e6\u05e2\u05d4 \u05d1\u05dc\u05d1\u05d3 / contract=\u05d4\u05e1\u05db\u05dd \u05d1\u05dc\u05d1\u05d3 / full=\u05d4\u05e6\u05e2\u05d4 + \u05d4\u05e1\u05db\u05dd)"
