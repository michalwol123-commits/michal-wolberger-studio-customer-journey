{
  "name": "AgentSettings",
  "type": "object",
  "properties": {
    "preview_mode": {
      "type": "boolean",
      "default": true,
      "description": "\u05de\u05e6\u05d1 \u05d3\u05d5\u05d2\u05de\u05d4: \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05d4\u05e1\u05d5\u05db\u05df \u05e0\u05e9\u05dc\u05d7\u05d5\u05ea \u05dc\u05de\u05d9\u05db\u05dc \u05d1\u05de\u05e7\u05d5\u05dd \u05dc\u05dc\u05e7\u05d5\u05d7"
    },
    "preview_email": {
      "type": "string",
      "description": "\u05de\u05d9\u05d9\u05dc \u05dc\u05e7\u05d1\u05dc\u05ea \u05d3\u05d5\u05d2\u05de\u05d0\u05d5\u05ea"
    },
    "preview_phone": {
      "type": "string",
      "description": "\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4 \u05dc\u05e7\u05d1\u05dc\u05ea \u05d3\u05d5\u05d2\u05de\u05d0\u05d5\u05ea"
    },
    "michal_phone": {
      "type": "string",
      "default": "0524687812",
      "description": "\u05d4\u05d8\u05dc\u05e4\u05d5\u05df \u05e9\u05dc \u05de\u05d9\u05db\u05dc \u05dc\u05e7\u05d1\u05dc\u05ea \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05de\u05d4\u05de\u05e2\u05e8\u05db\u05ea"
    },
    "notify_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05e9\u05dc\u05d5\u05d7 \u05dc\u05de\u05d9\u05db\u05dc \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea"
    },
    "notify_events": {
      "type": "array",
      "description": "\u05e1\u05d5\u05d2\u05d9 \u05d4\u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05e9\u05de\u05d9\u05db\u05dc \u05de\u05e7\u05d1\u05dc\u05ea",
      "items": {
        "type": "string",
        "enum": [
          "questionnaire_submitted",
          "document_signed",
          "document_approval",
          "portal_comment",
          "concept_approved",
          "floor_plan_confirmed",
          "quote_approved"
        ]
      },
      "default": [
        "questionnaire_submitted",
        "document_signed",
        "document_approval",
        "portal_comment",
        "concept_approved",
        "floor_plan_confirmed",
        "quote_approved"
      ]
    },
    "michal_wa_slot_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05e9\u05dc\u05d9\u05d7\u05ea \u05d4\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df \u05e9\u05de\u05d5\u05e8 \u05dc\u05de\u05d9\u05db\u05dc (\u05dc\u05de\u05e8\u05d5\u05d5\u05d7 30 \u05e9\u05e0\u05d9\u05d5\u05ea)"
    }
  },
  "required": []
}