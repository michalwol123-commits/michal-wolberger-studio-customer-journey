{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05de\u05e0\u05d5\u05d9 (\u05d9\u05d9\u05d7\u05d5\u05d3\u05d9)"
    },
    "p256dh": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 \u05d4\u05e6\u05e4\u05e0\u05d4 \u05e9\u05dc \u05d4\u05de\u05db\u05e9\u05d9\u05e8"
    },
    "auth": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d3 \u05d0\u05d9\u05de\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05db\u05e9\u05d9\u05e8"
    },
    "user_email": {
      "type": "string",
      "description": "\u05de\u05d9\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "user_agent": {
      "type": "string",
      "description": "\u05d3\u05e4\u05d3\u05e4\u05df/\u05de\u05db\u05e9\u05d9\u05e8"
    },
    "last_ok_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05e9\u05dc\u05d9\u05d7\u05d4 \u05de\u05d5\u05e6\u05dc\u05d7\u05ea \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    }
  },
  "required": [
    "endpoint",
    "p256dh",
    "auth"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}