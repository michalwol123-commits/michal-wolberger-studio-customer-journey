        "coin",
        "ruler",
        "doc",
        "path",
        "chat",
        "check",
        "compass",
        "wave",
        "home",
        "gantt",
        "pen",
        "camera",
        "box",
        "heart",
        "palette",
        "calendar",
        "list"
      ],
      "default": "home",
      "description": "\u05d0\u05d9\u05d9\u05e7\u05d5\u05df \u05d4\u05d7\u05dc\u05e7"
    },
    "content": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05d7\u05d5\u05e4\u05e9\u05d9 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "items": {
      "type": "array",
      "description": "\u05e9\u05d0\u05dc\u05d5\u05ea/\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05e0\u05e4\u05ea\u05d7\u05d9\u05dd (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05e4\u05e8\u05d9\u05d8"
          },
          "a": {
            "type": "string",
            "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05e4\u05e8\u05d9\u05d8"
          }
        }
      }
    },
    "order": {
      "type": "number",
      "default": 0,
