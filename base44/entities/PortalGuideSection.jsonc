      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d7\u05dc\u05e7 \u05d1\u05de\u05d3\u05e8\u05d9\u05da"
    },
    "art": {
      "type": "string",
      "enum": [
