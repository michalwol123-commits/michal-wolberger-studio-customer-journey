{
  "name": "\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e9\u05dc\u05d1 + \u05e2\u05d3\u05db\u05d5\u05df qualified",
  "description": "\u05d9\u05d5\u05e6\u05e8 \u05de\u05e9\u05d9\u05de\u05ea \u05d4\u05e6\u05e2\u05ea \u05de\u05d7\u05d9\u05e8 \u05db\u05e9-s2 \u05de\u05d5\u05e9\u05dc\u05dd, \u05d5\u05de\u05e2\u05d3\u05db\u05df Client \u05dc-qualified \u05db\u05e9-s5 \u05de\u05d5\u05e9\u05dc\u05dd",
