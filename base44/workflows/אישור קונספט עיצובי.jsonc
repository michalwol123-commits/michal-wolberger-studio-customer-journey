{
  "name": "\u05d0\u05d9\u05e9\u05d5\u05e8 \u05e7\u05d5\u05e0\u05e1\u05e4\u05d8 \u05e2\u05d9\u05e6\u05d5\u05d1\u05d9",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"concept_status\") != null) and (.trigger.data.concept_status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Project"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoConceptApproval",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoConceptApproval"
  }
}