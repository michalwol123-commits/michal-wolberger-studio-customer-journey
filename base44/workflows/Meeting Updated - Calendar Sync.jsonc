{
  "name": "Meeting Updated - Calendar Sync",
  "description": "\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05e4\u05d2\u05d9\u05e9\u05d4 \u05dc\u05d9\u05d5\u05de\u05df \u05d2\u05d5\u05d2\u05dc \u05db\u05e9-Admin \u05de\u05e2\u05d3\u05db\u05df \u05d0\u05ea \u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e4\u05d2\u05d9\u05e9\u05d4",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"scheduled_at\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Meeting"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "meeting_updated_calendar_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoMeetingUpdated",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoMeetingUpdated"
  }
}