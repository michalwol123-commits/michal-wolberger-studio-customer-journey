{
  "name": "Cancel Guard \u2014 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d1\u05d5\u05d8\u05dc",
  "description": "\u05db\u05e9\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05de\u05d1\u05d5\u05d8\u05dc \u2192 WhatsApp \u05dc\u05de\u05d9\u05db\u05dc + \u05dc\u05d5\u05d2 \u05de\u05e2\u05e8\u05db\u05ea (PRD 3.3)",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"cancelled\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Project"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cancel_guard",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCancelGuard",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoCancelGuard"
  }
}