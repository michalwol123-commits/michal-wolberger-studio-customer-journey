{
  "name": "\u05d1\u05e8\u05d5\u05db\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd \u2014 \u05e1\u05d2\u05d9\u05e8\u05ea \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8",
  "description": "\u05e9\u05d5\u05dc\u05d7 \u05de\u05d9\u05d9\u05dc \u05d1\u05e8\u05d5\u05db\u05d9\u05dd \u05d4\u05d1\u05d0\u05d9\u05dd + \u05de\u05e2\u05d3\u05db\u05df Client \u05dc-active_client \u05db\u05e9\u05e0\u05e1\u05d2\u05e8 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 (s4\u2192completed)",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"s4_status\") != null) and (.trigger.data.s4_status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Project"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoWelcomeClient",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoWelcomeClient"
  }
}