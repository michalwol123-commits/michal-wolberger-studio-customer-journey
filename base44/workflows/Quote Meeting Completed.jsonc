{
  "name": "Quote Meeting Completed",
  "description": "\u05db\u05e9\u05e4\u05d2\u05d9\u05e9\u05ea \u05d4\u05e6\u05d2\u05ea \u05d4\u05e6\u05e2\u05ea \u05de\u05d7\u05d9\u05e8 \u05de\u05e1\u05d5\u05de\u05e0\u05ea \u05db\u05d4\u05d5\u05e9\u05dc\u05de\u05d4 \u2192 \u05de\u05e2\u05d3\u05db\u05df \u05e1\u05d8\u05d8\u05d5\u05e1 \u05dc\u05d9\u05d3 \u05dc\"\u05d4\u05d5\u05d2\u05e9\u05d4 \u05d1\u05e4\u05d2\u05d9\u05e9\u05d4\"",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\") and (.trigger.data.type == \"quote_presentation\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Meeting"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "quote_meeting_completed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoQuoteMeetingCompleted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoQuoteMeetingCompleted"
  }
}