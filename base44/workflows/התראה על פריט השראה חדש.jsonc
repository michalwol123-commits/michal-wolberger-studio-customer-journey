{
  "name": "\u05d4\u05ea\u05e8\u05d0\u05d4 \u05e2\u05dc \u05e4\u05e8\u05d9\u05d8 \u05d4\u05e9\u05e8\u05d0\u05d4 \u05d7\u05d3\u05e9",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.data.uploader_role == \"staff\") and (.trigger.data.is_approved == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "InspirationItem"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoInspirationNotify",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoInspirationNotify"
  }
}