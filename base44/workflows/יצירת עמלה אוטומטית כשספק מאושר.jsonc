{
  "name": "\u05d9\u05e6\u05d9\u05e8\u05ea \u05e2\u05de\u05dc\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05db\u05e9\u05e1\u05e4\u05e7 \u05de\u05d0\u05d5\u05e9\u05e8",
  "description": "\u05d9\u05d5\u05e6\u05e8 \u05e8\u05e9\u05d5\u05de\u05ea Commission \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05db\u05d0\u05e9\u05e8 ProjectSupplier \u05e2\u05d5\u05d1\u05e8 \u05dc\u05e1\u05d8\u05d8\u05d5\u05e1 approved \u05d0\u05d5 completed",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"approved\") or (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ProjectSupplier"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCommission",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoCommission"
  }
}