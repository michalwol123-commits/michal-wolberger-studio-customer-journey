{
  "name": "C \u2014 Qualifying Payment",
  "description": "\u05db\u05e9\u05ea\u05e9\u05dc\u05d5\u05dd \u05de\u05e1\u05d5\u05de\u05df \u05db-paid \u2192 \u05de\u05e2\u05d3\u05db\u05df \u05e1\u05d8\u05d8\u05d5\u05e1 \u05dc\u05e7\u05d5\u05d7",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"paid\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Payment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "c_qualifying_payment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoQualifyingPayment",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoQualifyingPayment"
  }
}