{
  "name": "\u05d4\u05ea\u05e8\u05d0\u05d4 \u05dc\u05de\u05d9\u05db\u05dc \u2014 \u05ea\u05d2\u05d5\u05d1\u05d4 \u05dc\u05d3\u05d5\u05d7 \u05e9\u05d8\u05d7",
  "description": "\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4 \u05dc\u05de\u05d9\u05db\u05dc \u05db\u05e9\u05dc\u05e7\u05d5\u05d7 \u05de\u05d2\u05d9\u05d1 \u05e2\u05dc \u05d3\u05d5\u05d7 \u05e9\u05d8\u05d7",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "FieldVisit",
      "events": [
        "update"
      ]
    },
    "condition": "${ ((.trigger.changed_fields // []) | index(\"client_comment\")) != null or ((.trigger.changed_fields // []) | index(\"client_reaction\")) != null }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_field_visit",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyMichal",
            "args": {
              "event": "portal_comment",
              "entity_name": "FieldVisit",
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05d4\u05ea\u05e8\u05d0\u05d4 \u05dc\u05de\u05d9\u05db\u05dc"
          }
        }
      }
    ]
  }
}