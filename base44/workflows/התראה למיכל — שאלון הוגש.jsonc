{
  "name": "\u05d4\u05ea\u05e8\u05d0\u05d4 \u05dc\u05de\u05d9\u05db\u05dc \u2014 \u05e9\u05d0\u05dc\u05d5\u05df \u05d4\u05d5\u05d2\u05e9",
  "description": "\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4 \u05dc\u05de\u05d9\u05db\u05dc \u05db\u05e9\u05dc\u05e7\u05d5\u05d7 \u05de\u05d2\u05d9\u05e9 \u05e9\u05d0\u05dc\u05d5\u05df",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Questionnaire",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"submitted\" and (.trigger.old_data.status // \"\") != \"submitted\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_questionnaire",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyMichal",
            "args": {
              "event": "questionnaire_submitted",
              "entity_name": "Questionnaire",
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05d4\u05ea\u05e8\u05d0\u05d4 \u05dc\u05de\u05d9\u05db\u05dc"
          }
        }
      }
    ]
  }
}