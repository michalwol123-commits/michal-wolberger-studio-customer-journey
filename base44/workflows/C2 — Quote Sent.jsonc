{
  "name": "C2 \u2014 Quote Sent",
  "description": "\u05db\u05e9\u05d4\u05e6\u05e2\u05ea \u05de\u05d7\u05d9\u05e8 \u05de\u05ea\u05e2\u05d3\u05db\u05e0\u05ea \u05dc\u05e1\u05d8\u05d8\u05d5\u05e1 \"\u05e0\u05e9\u05dc\u05d7\u05d4\" \u2192 \u05e9\u05d5\u05dc\u05d7 \u05de\u05d9\u05d9\u05dc/\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4 \u05dc\u05dc\u05e7\u05d5\u05d7",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"sent\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Quote"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "c2_quote_sent",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoQuoteSent",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoQuoteSent"
  }
}