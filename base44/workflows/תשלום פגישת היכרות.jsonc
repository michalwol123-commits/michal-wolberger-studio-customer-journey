{
  "name": "\u05ea\u05e9\u05dc\u05d5\u05dd \u05e4\u05d2\u05d9\u05e9\u05ea \u05d4\u05d9\u05db\u05e8\u05d5\u05ea",
  "description": "\u05db\u05e9\u05dc\u05d9\u05d3 \u05e2\u05d5\u05d1\u05e8 \u05dc\u05e1\u05d8\u05d8\u05d5\u05e1 \"\u05de\u05ea\u05e2\u05e0\u05d9\u05d9\u05df\" \u2014 \u05e0\u05d5\u05e6\u05e8 \u05ea\u05e9\u05dc\u05d5\u05dd \u20aa250, \u05de\u05e9\u05d9\u05de\u05ea \u05ea\u05d6\u05db\u05d5\u05e8\u05ea, \u05d5\u05e8\u05e9\u05d5\u05de\u05ea \u05ea\u05e7\u05e9\u05d5\u05e8\u05ea",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"qualified\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Client"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoQualifyingPayment",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoQualifyingPayment"
  }
}