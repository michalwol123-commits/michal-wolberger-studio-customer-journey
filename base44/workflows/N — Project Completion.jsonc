{
  "name": "N \u2014 Project Completion",
  "description": "\u05db\u05e9\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05e2\u05d5\u05d1\u05e8 \u05dc\u05e1\u05d8\u05d8\u05d5\u05e1 completed \u2192 \u05de\u05e2\u05d3\u05db\u05df \u05dc\u05e7\u05d5\u05d7 \u05d5\u05e9\u05d5\u05dc\u05d7 NPS",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Project"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "n_project_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoProjectCompletion",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoProjectCompletion"
  }
}