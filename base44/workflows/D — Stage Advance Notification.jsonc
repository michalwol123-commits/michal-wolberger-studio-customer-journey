{
  "name": "D \u2014 Stage Advance Notification",
  "description": "\u05e9\u05dc\u05d1 \u05d1\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05ea\u05e7\u05d3\u05dd \u2192 \u05d4\u05d5\u05d3\u05e2\u05d4 \u05dc\u05dc\u05e7\u05d5\u05d7 + \u05de\u05e9\u05d9\u05de\u05d4",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"stage_current\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Project"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "d_stage_advance_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoStageAdvance",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoStageAdvance"
  }
}