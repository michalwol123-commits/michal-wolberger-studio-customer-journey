{
  "name": "\u05d4\u05ea\u05e8\u05d0\u05d4 \u05dc\u05de\u05d9\u05db\u05dc \u2014 \u05d0\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05d1\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8",
  "description": "\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4 \u05dc\u05de\u05d9\u05db\u05dc \u05db\u05e9\u05dc\u05e7\u05d5\u05d7 \u05de\u05d0\u05e9\u05e8 \u05e7\u05d5\u05e0\u05e1\u05e4\u05d8 \u05d0\u05d5 \u05ea\u05db\u05e0\u05d9\u05ea \u05d4\u05e2\u05de\u05d3\u05d4",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Project",
      "events": [
        "update"
      ]
    },
    "condition": "${ (.trigger.data.concept_status == \"approved\" and (.trigger.old_data.concept_status // \"\") != \"approved\") or (.trigger.data.floor_plan_locked == true and (.trigger.old_data.floor_plan_locked // false) != true) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_project_approvals",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "pick": {
          "switch": [
            {
              "when": "${ .trigger.data.concept_status == \"approved\" and (.trigger.old_data.concept_status // \"\") != \"approved\" }",
              "then": "notify_concept"
            },
            {
              "when": "${ true }",
              "then": "notify_floor_plan"
            }
          ],
          "x-base44": {
            "title": "\u05d0\u05d9\u05d6\u05d4 \u05d0\u05d9\u05e9\u05d5\u05e8?"
          }
        }
      },
      {
        "notify_concept": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyMichal",
            "args": {
              "event": "concept_approved",
              "entity_name": "Project",
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05d4\u05ea\u05e8\u05d0\u05d4: \u05e7\u05d5\u05e0\u05e1\u05e4\u05d8 \u05d0\u05d5\u05e9\u05e8"
          }
        }
      },
      {
        "notify_floor_plan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyMichal",
            "args": {
              "event": "floor_plan_confirmed",
              "entity_name": "Project",
              "entity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05d4\u05ea\u05e8\u05d0\u05d4: \u05ea\u05db\u05e0\u05d9\u05ea \u05d4\u05e2\u05de\u05d3\u05d4 \u05d0\u05d5\u05e9\u05e8\u05d4"
          }
        }
      }
    ]
  }
}